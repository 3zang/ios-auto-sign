{
  "listen": "127.0.0.1:8080",
  "public_base_url": "https://sign.example.com",
  "data_dir": "data",
  "master_key_file": "master.key",
  "zsign_path": "bin/zsign",
  "poll_interval_minutes": 30,
  "keep_versions": 2,
  "http_timeout_seconds": 60,
  "default_source_url": "https://raw.githubusercontent.com/bebound/AltGallery/refs/heads/master/all-apps.json",
  "plist": {
    "mode": "plistserver",
    "plistserver_url": "https://api.palera.in/genPlist",
    "ipa_base_url": ""
  },
  "sign_options": {
    "zip_level": 9,
    "force": false,
    "adhoc": false,
    "extra_args": []
  }
}
